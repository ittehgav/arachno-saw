shader_parameter/gloss = 0.238000011305
shader_parameter/roughness_base = 0.15
shader_parameter/hourglass_center = Vector2(0.75, 0.39)
shader_parameter/hourglass_height = 0.10500000335756
shader_parameter/hourglass_width = 0.3
shader_parameter/waist_pinch = 0.85
